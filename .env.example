# =============================================
# 卖课小程序 - 环境变量配置示例
# =============================================
# 复制此文件为 .env 并填写实际值
# 所有配置由 Coze 平台自动注入，无需手动配置

# ==================== 项目配置 ====================
# 项目工作目录
# COZE_WORKSPACE_PATH=/workspace/projects

# 对外访问域名（不含协议）
# COZE_PROJECT_DOMAIN_DEFAULT=https://your-app.coze.cn

# 运行环境：DEV（开发环境）/ PROD（生产环境）
# COZE_PROJECT_ENV=DEV

# 服务监听端口（固定为 5000）
# DEPLOY_RUN_PORT=5000

# ==================== Supabase 数据库 ====================
# 数据库连接 URL（自动注入）
# COZE_SUPABASE_URL=https://xxxx.supabase.co

# 匿名密钥 - 用于前端，受 RLS 约束（自动注入）
# COZE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 服务端密钥 - 用于后端，绕过 RLS（自动注入，如有）
# COZE_SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ==================== 对象存储 ====================
# 对象存储端点（自动注入）
# COZE_BUCKET_ENDPOINT_URL=https://oss.coze.cn

# 存储桶名称（自动注入）
# COZE_BUCKET_NAME=your-bucket

# 存储区域（自动注入）
# COZE_BUCKET_REGION=cn-beijing

# ==================== 业务配置 ====================
# JWT 签名密钥（生产环境必须修改）
# JWT_SECRET=your-super-secret-key-change-in-production

# Token 过期时间（毫秒），默认 7 天
# JWT_EXPIRES_IN=604800000

# 短信验证码过期时间（秒）
# SMS_CODE_EXPIRES_IN=60

# 短信验证码长度
# SMS_CODE_LENGTH=6

# 应用名称
# APP_NAME=卖课小程序

# 默认分页大小
# DEFAULT_PAGE_SIZE=10

# 最大分页大小
# MAX_PAGE_SIZE=100

# 文件上传大小限制（字节），默认 5MB
# MAX_FILE_SIZE=5242880
